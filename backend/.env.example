# CarbEarn Backend Environment Variables

# Application Environment (development | production)
NODE_ENV=development
PORT=5000

# Database Configuration (supports MySQL and PostgreSQL)
# Option A: Standard individual variables
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=carbearn
DB_SSL=false

# Option B: Managed Cloud Connection URL (e.g. Neon, Supabase, Render, PlanetScale)
# DATABASE_URL=postgresql://user:password@host:5432/carbearn?sslmode=require
# DATABASE_URL=mysql://user:password@host:3306/carbearn

# Security & Authentication
JWT_SECRET=carbearn-super-secure-production-secret-replace-me-32chars

# Initial Administrator Credentials (seeded on first migration)
ADMIN_EMAIL=admin@carbearn.com
ADMIN_PASSWORD=Admin@12345
ADMIN_REGISTRATION_SECRET=CARBEARN_ADMIN_2026

# Machine Learning Microservice
ML_SERVICE_URL=http://127.0.0.1:5001

# CORS Authorized Origins (comma-separated for multi-origin)
CORS_ORIGIN=http://localhost:5000,http://127.0.0.1:5000
